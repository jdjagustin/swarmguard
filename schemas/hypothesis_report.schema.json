{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HypothesisReport",
  "description": "Structured message emitted by the Investigator agent after analyzing a SuspicionSignal: one or more hypotheses, each with a confidence level and supporting evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "created_at", "source_agent", "signal_id", "hypotheses"],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^rep-[0-9a-f]{6,}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_agent": {
      "type": "string",
      "enum": ["investigator"]
    },
    "signal_id": {
      "type": "string",
      "pattern": "^sig-[0-9a-f]{6,}$"
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "explanation", "confidence", "category", "evidence"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "category": {
            "type": "string",
            "enum": ["card_testing", "credential_stuffing", "misconfiguration", "benign", "unknown"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "reference"],
              "properties": {
                "source": {
                  "type": "string",
                  "enum": ["cloudwatch_logs", "vpc_flow_logs", "application_logs", "stripe_event"]
                },
                "reference": { "type": "string" },
                "excerpt": { "type": "string" },
                "observed_at": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    }
  }
}
